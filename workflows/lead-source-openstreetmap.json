                      "id":  "osm-webhook-001",
                      "name":  "Receber filtros OSM",
                      "type":  "n8n-nodes-base.webhook",
                      "typeVersion":  2,
                      "position":  [
                                       -900,
                                       120
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "\nconst body = $json.body || $json;\nconst nicho = String(body.nicho || \u0027\u0027).trim();\nconst cidade = String(body.cidades || \u0027\u0027).split(\u0027;\u0027).map(c =\u003e c.trim()).filter(Boolean)[0] || \u0027\u0027;\nconst limite = Math.min(Math.max(Number(body.maxResultadosPorCidade || 20), 1), 50);\nconst prioridadeMinima = String(body.prioridadeMinima || \u0027Todas\u0027);\nif (!nicho) throw new Error(\u0027Informe um nicho.\u0027);\nif (!cidade) throw new Error(\u0027Informe pelo menos uma cidade.\u0027);\nreturn [{ json: { nicho, cidade, limite, prioridadeMinima, geoUrl: \u0027https://nominatim.openstreetmap.org/search?q=\u0027 + encodeURIComponent(cidade) + \u0027\u0026format=json\u0026limit=1\u0026countrycodes=br\u0027 } }];\n"
                                     },
                      "id":  "osm-prep-002",
                      "name":  "Preparar consulta OSM",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -680,
                                       120
                                   ]
                  },
                  {
                      "parameters":  {
                                         "url":  "={{ $json.geoUrl }}",
                                         "sendHeaders":  true,
                                         "headerParameters":  {
                                                                  "parameters":  [
