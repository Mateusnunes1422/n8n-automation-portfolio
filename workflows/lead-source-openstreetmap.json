                      "id":  "osm-geo-003",
                      "name":  "Geocodificar cidade OSM",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       -450,
                                       120
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "\nconst original = $(\u0027Preparar consulta OSM\u0027).item.json;\nconst geo = Array.isArray($json) ? $json : ($json.lat ? [$json] : ($json.body || []));\nif (!Array.isArray(geo) || !geo.length) return [{ json:{ ...original, overpassUrl:\u0027https://overpass-api.de/api/interpreter?data=\u0027 + encodeURIComponent(\u0027[out:json][timeout:5];node(0,0,0,0);out;\u0027) } }];\nconst lat = Number(geo[0].lat), lon = Number(geo[0].lon);\nconst nicho = original.nicho.toLowerCase();\nconst radius = 25000;\nfunction clean(s){ return s.replace(/[\\\"\u0027]/g, \u0027\u0027).slice(0, 80); }\nfunction area(filter){ return \u0027node\u0027 + filter + \u0027(around:\u0027 + radius + \u0027,\u0027 + lat + \u0027,\u0027 + lon + \u0027);way\u0027 + filter + \u0027(around:\u0027 + radius + \u0027,\u0027 + lat + \u0027,\u0027 + lon + \u0027);\u0027; }\nlet filters = [];\nif (/barbear|barber|barbeiro|cabelo|salao|salão|cabeleireiro/.test(nicho)) {\n  filters = [\n    \u0027[\"shop\"=\"hairdresser\"]\u0027,\n    \u0027[\"craft\"=\"barber\"]\u0027\n  ];\n} else if (/dent|odonto/.test(nicho)) {\n  filters = [\u0027[\"amenity\"=\"dentist\"]\u0027,\u0027[\"healthcare\"=\"dentist\"]\u0027,\u0027[\"name\"~\"dent|odonto|sorriso|oral\",i]\u0027];\n} else if (/estet|beleza|beauty|spa/.test(nicho)) {\n  filters = [\u0027[\"shop\"=\"beauty\"]\u0027,\u0027[\"beauty\"]\u0027,\u0027[\"name\"~\"estet|estética|beleza|beauty|spa|skin\",i]\u0027];\n} else if (/pet|veterin/.test(nicho)) {\n  filters = [\u0027[\"shop\"=\"pet\"]\u0027,\u0027[\"amenity\"=\"veterinary\"]\u0027,\u0027[\"name\"~\"pet|veterin\",i]\u0027];\n} else if (/academ|fitness|gym/.test(nicho)) {\n  filters = [\u0027[\"leisure\"=\"fitness_centre\"]\u0027,\u0027[\"sport\"=\"fitness\"]\u0027,\u0027[\"name\"~\"academ|fitness|gym|treino\",i]\u0027];\n} else if (/restaurante|lanch|pizza|food/.test(nicho)) {\n  filters = [\u0027[\"amenity\"=\"restaurant\"]\u0027,\u0027[\"amenity\"=\"fast_food\"]\u0027,\u0027[\"name\"~\"restaurante|lanch|pizza|food\",i]\u0027];\n} else if (/farmacia|farmácia/.test(nicho)) {\n  filters = [\u0027[\"amenity\"=\"pharmacy\"]\u0027,\u0027[\"shop\"=\"chemist\"]\u0027,\u0027[\"name\"~\"farm\",i]\u0027];\n} else if (/oficina|mecan|auto/.test(nicho)) {\n  filters = [\u0027[\"shop\"=\"car_repair\"]\u0027,\u0027[\"craft\"=\"mechanic\"]\u0027,\u0027[\"name\"~\"oficina|mecan|auto\",i]\u0027];\n} else {\n  filters = [\u0027[\"name\"~\"\u0027 + clean(original.nicho) + \u0027\",i]\u0027];\n}\nconst union = filters.map(area).join(\u0027\u0027);\nconst query = \u0027[out:json][timeout:15];(\u0027 + union + \u0027);out center tags \u0027 + original.limite + \u0027;\u0027;\nreturn [{ json:{ ...original, overpassUrl:\u0027https://overpass-api.de/api/interpreter?data=\u0027 + encodeURIComponent(query) } }];\n"
                                     },
