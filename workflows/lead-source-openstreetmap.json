                      "id":  "osm-overpass-005",
                      "name":  "Buscar dados no Overpass",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       20,
                                       120
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "\nconst original = $(\u0027Montar query Overpass\u0027).item.json;\nconst data = $json;\nconst elements = data.elements || [];\nconst peso = { Baixa:1, Media:2, Alta:3 };\nconst seen = new Set();\nconst leads = [];\nfor (const el of elements) {\n  const tags = el.tags || {};\n  const name = tags.name || tags.brand || \u0027\u0027;\n  if (!name) continue;\n  const phone = tags.phone || tags[\u0027contact:phone\u0027] || tags[\u0027contact:mobile\u0027] || \u0027\u0027;\n  const site = tags.website || tags[\u0027contact:website\u0027] || tags.url || \u0027\u0027;\n  const lat = el.lat || el.center?.lat || \u0027\u0027;\n  const lon = el.lon || el.center?.lon || \u0027\u0027;\n  const endereco = [tags[\u0027addr:street\u0027], tags[\u0027addr:housenumber\u0027], tags[\u0027addr:suburb\u0027], tags[\u0027addr:city\u0027]].filter(Boolean).join(\u0027, \u0027);\n  const atividadeCompat = tags.shop || tags.amenity || tags.craft || tags.healthcare || tags.leisure || tags.tourism || tags.beauty || tags.hairdresser;\n  const score = (atividadeCompat ? 35 : 0) + (phone ? 25 : 0) + (site ? 10 : 0) + (endereco ? 15 : 0) + (lat \u0026\u0026 lon ? 15 : 0);\n  const prioridade = score \u003e= 70 ? \u0027Alta\u0027 : score \u003e= 40 ? \u0027Media\u0027 : \u0027Baixa\u0027;\n  if (original.prioridadeMinima !== \u0027Todas\u0027 \u0026\u0026 peso[prioridade] \u003c peso[original.prioridadeMinima]) continue;\n  const key = (name + \u0027|\u0027 + original.cidade + \u0027|\u0027 + endereco).toLowerCase();\n  if (seen.has(key)) continue;\n  seen.add(key);\n  leads.push({ nicho:original.nicho, cidadeBusca:original.cidade, nomeEmpresa:name, telefone:phone, endereco, site, semSite:!site, rating:\u0027\u0027, quantidadeAvaliacoes:\u0027\u0027, latitude:lat, longitude:lon, googleMaps: lat \u0026\u0026 lon ? \u0027https://www.google.com/maps/search/?api=1\u0026query=\u0027 + lat + \u0027,\u0027 + lon : \u0027\u0027, osmUrl:\u0027https://www.openstreetmap.org/\u0027 + el.type + \u0027/\u0027 + el.id, prioridade, scoreProspeccao:score, origem:\u0027OpenStreetMap Overpass API\u0027, coletadoEm:new Date().toISOString() });\n}\nleads.sort((a,b) =\u003e b.scoreProspeccao - a.scoreProspeccao);\nreturn [{ json:{ success:true, total:leads.length, leads } }];\n"
                                     },
