                      "id":  "7fcb226f-cb75-469e-9d37-fe2603c712b3",
                      "name":  "Filtrar leads validos",
                      "type":  "n8n-nodes-base.if",
                      "typeVersion":  2.2,
                      "position":  [
                                       544,
                                       368
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const seen = new Set();\nconst leads = [];\n\nfor (const item of $input.all()) {\n  const lead = item.json;\n  const chave = lead.place_id || `${lead.nome_empresa}-${lead.endereco}`.toLowerCase();\n  if (seen.has(chave)) continue;\n  seen.add(chave);\n  leads.push({ json: lead });\n}\n\nleads.sort((a, b) =\u003e Number(b.json.pontuacao_lead || 0) - Number(a.json.pontuacao_lead || 0));\nreturn leads;"
                                     },
