                      "id":  "94d8df3e-51bb-42b2-99dc-8eaf7a3de3f6",
                      "name":  "Configuracao da prospeccao",
                      "type":  "n8n-nodes-base.set",
                      "typeVersion":  3.4,
                      "position":  [
                                       -480,
                                       368
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const segmentos = $json.segmentos.split(\u0027,\u0027).map(s =\u003e s.trim()).filter(Boolean);\nconst cidades = $json.cidades.split(\u0027,\u0027).map(c =\u003e c.trim()).filter(Boolean);\nconst limite = Number($json.limite_por_busca || 10);\nconst apiKey = $json.google_places_api_key;\n\nconst buscas = [];\nfor (const cidade of cidades) {\n  for (const segmento of segmentos) {\n    buscas.push({\n      segmento,\n      cidade,\n      termo_busca: `${segmento} em ${cidade} SP`,\n      limite_por_busca: limite,\n      google_places_api_key: apiKey\n    });\n  }\n}\n\nreturn buscas.map(busca =\u003e ({ json: busca }));"
                                     },
                      "id":  "75a9fe7d-cf8d-4fbe-ac61-5c1f943595f2",
                      "name":  "Gerar buscas por cidade e segmento",
                      "type":  "n8n-nodes-base.code",
                      "typeVersion":  2,
                      "position":  [
                                       -240,
                                       368
                                   ]
                  },
                  {
                      "parameters":  {
                                         "url":  "https://maps.googleapis.com/maps/api/place/textsearch/json",
                                         "sendQuery":  true,
                                         "queryParameters":  {
                                                                 "parameters":  [
                                                                                    {
                                                                                        "name":  "query",
                                                                                        "value":  "={{ $json.termo_busca }}"
                                                                                    },
                                                                                    {
                                                                                        "name":  "key",
                                                                                        "value":  "={{ $json.google_places_api_key }}"
                                                                                    },
                                                                                    {
                                                                                        "name":  "language",
                                                                                        "value":  "pt-BR"
                                                                                    },
                                                                                    {
                                                                                        "name":  "region",
                                                                                        "value":  "br"
                                                                                    }
                                                                                ]
                                                             },
                                         "options":  {
                                                         "response":  {
                                                                          "response":  {
                                                                                           "responseFormat":  "json"
                                                                                       }
                                                                      }
                                                     }
                                     },
                      "id":  "1604cf34-f314-414c-80ac-b350e048d0fd",
                      "name":  "Buscar empresas no Google Places",
                      "type":  "n8n-nodes-base.httpRequest",
                      "typeVersion":  4.2,
                      "position":  [
                                       32,
                                       368
                                   ]
                  },
                  {
                      "parameters":  {
                                         "jsCode":  "const origem = $(\u0027Gerar buscas por cidade e segmento\u0027).item.json;\nconst resultados = $json.results || [];\nconst limite = Number(origem.limite_por_busca || 10);\n\nreturn resultados.slice(0, limite).map(place =\u003e {\n  const rating = place.rating || 0;\n  const avaliacoes = place.user_ratings_total || 0;\n  const aberto = place.opening_hours?.open_now;\n  const endereco = place.formatted_address || \u0027\u0027;\n\n  let pontuacao = 0;\n  if (rating \u003e= 4.4) pontuacao += 25;\n  if (avaliacoes \u003e= 50) pontuacao += 25;\n  if (place.business_status === \u0027OPERATIONAL\u0027) pontuacao += 20;\n  if (endereco.toLowerCase().includes(origem.cidade.toLowerCase())) pontuacao += 15;\n  if (place.types?.length) pontuacao += 15;\n\n  return {\n    json: {\n      nome_empresa: place.name || \u0027\u0027,\n      segmento_pesquisado: origem.segmento,\n      cidade_pesquisada: origem.cidade,\n      endereco,\n      rating,\n      total_avaliacoes: avaliacoes,\n      status_google: place.business_status || \u0027\u0027,\n      aberto_agora: aberto === undefined ? \u0027nao_informado\u0027 : aberto,\n      place_id: place.place_id || \u0027\u0027,\n      tipos_google: (place.types || []).join(\u0027, \u0027),\n      link_google_maps: place.place_id ? `https://www.google.com/maps/place/?q=place_id:${place.place_id}` : \u0027\u0027,\n      pontuacao_lead: pontuacao,\n      prioridade: pontuacao \u003e= 70 ? \u0027alta\u0027 : pontuacao \u003e= 45 ? \u0027media\u0027 : \u0027baixa\u0027,\n      status_prospeccao: \u0027novo\u0027,\n      sugestao_abordagem: `Olá, tudo bem? Vi a ${place.name || \u0027empresa\u0027} em ${origem.cidade} e queria entender se voces ja usam automacoes para captar e atender clientes.`\n    }\n  };\n});"
                                     },
