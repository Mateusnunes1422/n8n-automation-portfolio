<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="8dp"
    android:paddingEnd="8dp">

    <LinearLayout
        android:id="@+id/card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingEnd="15dp"
        android:paddingTop="12dp"
        android:paddingBottom="13dp"
        android:elevation="12dp">

        <!-- De qual app veio a oferta, distancia e tempo totais -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/appBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_badge"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Uber"
                android:textColor="@color/card_value"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="9dp"
                android:maxLines="1"
                android:text=""
                android:textColor="@color/card_value"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />
        </LinearLayout>

        <!-- As quatro metricas, cada uma com a sua barra de cor -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/Km"
                android:textColor="@color/card_label"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/kmBar"
                    android:layout_width="4dp"
                    android:layout_height="31dp"
                    android:background="@color/lvl_none" />

                <TextView
                    android:id="@+id/kmValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/card_value"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$/Hora"
                android:textColor="@color/card_label"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/hourBar"
                    android:layout_width="4dp"
                    android:layout_height="31dp"
                    android:background="@color/lvl_none" />

                <TextView
                    android:id="@+id/hourValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/card_value"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nota"
                android:textColor="@color/card_label"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/ratingBar"
                    android:layout_width="4dp"
                    android:layout_height="31dp"
                    android:background="@color/lvl_none" />

                <TextView
                    android:id="@+id/ratingValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/card_value"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="9dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lucro %"
                android:textColor="@color/card_label"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal">

                <View
                    android:id="@+id/profitBar"
                    android:layout_width="4dp"
                    android:layout_height="31dp"
                    android:background="@color/lvl_none" />

                <TextView
                    android:id="@+id/profitValue"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="7dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="--"
                    android:textColor="@color/card_value"
                    android:textSize="29sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="-0.03" />
            </LinearLayout>
        </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/alert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:background="@drawable/bg_alert"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="7dp"
            android:paddingBottom="7dp"
            android:text=""
            android:textColor="#FF9A94"
            android:textSize="12.5sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
